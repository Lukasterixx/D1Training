# Rebuilt from d1_arm/d1.urdf + the cloud go2.usd on every run.
generated/

__pycache__/
*.py[cod]
.vscode/

# Thesis B experiment outputs; preserve the original tracked walking checkpoint.
logs/position_only/
logs/playback/
logs/pick_demo/
logs/d1_ui/
# Hardware sessions: the recorded copy under results/week_NN/runs/ is the evidence.
logs/hardware/
logs/pick_hardware/
# Renders of the camera body, tens of megabytes of them; the figures kept are in results/week_NN/figures/.
logs/camera_body/
logs/combiner_demo/
logs/insertion_demo/

# The UniFP sim-to-sim port: rollouts on the Isaac Lab model, and the matching Isaac Gym runs
# they are read against. Each run also rebuilds its own USD; the recorded copies are the evidence.
logs/unifp_isaaclab/
logs/unifp_gym_flat/
logs/unifp_train/
logs/unifp_demos/
# The combiner door's robot program's records, copied back from the dog by `d1fetch`; the recorded copies are the evidence.
logs/combiner_door_robot/
# The UniFP gait probe's runs (each with its own USD); the recorded copies are the evidence.
logs/unifp_gait_probe/
# The leg policy's shadow runs and the knee logger's records from the dog (`d1fetch`), and their PC tests; the recorded
# copies are the evidence. The combiner key demo's runs likewise.
logs/leg_shadow/
logs/leg_shadow_pc_test/
logs/go2_knee/
logs/combiner_key/
# Top-level console logs of demo and test runs; the recorded copies are the evidence.
logs/*.out
